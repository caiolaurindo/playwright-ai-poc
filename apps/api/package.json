{
  "name": "@agendalab/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc-watch --onSuccess \"node --env-file-if-exists=.env dist/main.js\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "db:reset": "node --env-file-if-exists=.env ./scripts/reset-db.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsc-watch": "^7.2.0",
    "typescript": "^5.9.3"
  }
}
